<Window x:Class="ExcelFormAssistant.Views.FormDiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostic du formulaire – Excel Form Assistant"
        Width="980" Height="460" MinWidth="600" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ContextText" Margin="0,4,0,8" Foreground="#555555" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#555555" FontSize="12"
                       Text="Diagnostic seulement : aucun champ n'est rempli. Les cadres colorés à l'écran portent les mêmes numéros." />
            <Button DockPanel.Dock="Right" Content="Fermer" Padding="14,4" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="Nouvelle analyse" Padding="14,4" Margin="8,0,0,0" Click="Again_Click" />
            <Button DockPanel.Dock="Right" x:Name="CopyButton" Content="Copier le rapport" Padding="14,4" Click="Copy_Click"
                    ToolTip="Copie un résumé sans aucune valeur (ni du fichier Excel, ni du formulaire)" />
        </DockPanel>

        <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DDDDDD" Background="White"
                  RowHeight="26" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="40" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="120" />
                <DataGridTextColumn Header="Libellé trouvé" Binding="{Binding Label}" Width="2*" />
                <DataGridTextColumn Header="Source du libellé" Binding="{Binding SourceText}" Width="120" />
                <DataGridTextColumn Header="Colonne Excel" Binding="{Binding ColumnName}" Width="*" />
                <DataGridTextColumn Header="Valeur qui serait collée" Binding="{Binding PreviewValue}" Width="*" />
                <DataGridTextColumn Header="Résultat" Binding="{Binding OutcomeText}" Width="1.4*" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Outcome}" Value="WouldFill">
                            <Setter Property="Background" Value="#E1F0E5" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Outcome}" Value="NoColumn">
                            <Setter Property="Background" Value="#FBEBDD" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Outcome}" Value="NoLabel">
                            <Setter Property="Background" Value="#F8DEDC" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>
