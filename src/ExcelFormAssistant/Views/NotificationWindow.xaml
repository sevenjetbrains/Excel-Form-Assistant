<Window x:Class="ExcelFormAssistant.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Form Assistant"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        IsHitTestVisible="False">
    <Border x:Name="Bubble" CornerRadius="6" Padding="12,7" MaxWidth="360">
        <TextBlock x:Name="MessageText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
    </Border>
</Window>
