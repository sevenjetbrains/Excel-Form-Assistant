<Window x:Class="ExcelFormAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="900" Height="550" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Barre d'outils -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button Content="Ouvrir Excel" Command="{Binding OpenCommand}" Padding="12,4" />
        </StackPanel>

        <!-- Barre d'état -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Colonnes générées dans MainWindow.xaml.cs à partir des en-têtes du fichier -->
        <DataGrid x:Name="DataTable"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#DDDDDD"
                  Background="White"
                  RowHeight="26"
                  MinColumnWidth="80"
                  Margin="8,0,8,8" />
    </DockPanel>
</Window>
