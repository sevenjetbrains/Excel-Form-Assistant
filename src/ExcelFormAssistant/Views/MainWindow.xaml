<Window x:Class="ExcelFormAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExcelFormAssistant.Views"
        Title="{Binding WindowTitle}"
        Width="900" Height="550" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Barre d'outils -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button Content="Ouvrir Excel" Command="{Binding OpenCommand}" Padding="12,4" />
            <TextBlock Text="Feuille :" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox ItemsSource="{Binding SheetNames}"
                      SelectedItem="{Binding SelectedSheet}"
                      MinWidth="160"
                      IsEnabled="{Binding FilePath, Converter={x:Static views:NotNullConverter.Instance}}" />
            <Button Content="Menu Données Excel" Click="ShowDataMenu_Click" Padding="12,4" Margin="16,0,0,0"
                    ToolTip="Ouvre le menu de la ligne active près de la souris" />
        </StackPanel>

        <!-- Barre d'état -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding ActiveRowText}" FontWeight="SemiBold" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding StatusText}" Foreground="#555555" />
            </StatusBarItem>
        </StatusBar>

        <!-- Colonnes générées dans MainWindow.xaml.cs à partir des en-têtes du fichier -->
        <DataGrid x:Name="DataTable"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#DDDDDD"
                  Background="White"
                  RowHeight="26"
                  MinColumnWidth="80"
                  PreviewKeyDown="DataTable_PreviewKeyDown"
                  Margin="8,0,8,8">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataTableRow_MouseDoubleClick" />
                    <Style.Triggers>
                        <!-- Ligne active : en gras sur fond jaune pâle -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static views:ReferenceEqualsConverter.Instance}">
                                    <Binding />
                                    <Binding Path="DataContext.ActiveRow" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Background" Value="#FFF3C4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>
