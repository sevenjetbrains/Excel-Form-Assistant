<Window x:Class="ExcelFormAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExcelFormAssistant.Views"
        Title="{Binding WindowTitle}"
        Width="900" Height="550" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <!-- Barre d'outils -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button Content="Ouvrir Excel" Command="{Binding OpenCommand}" Padding="12,4" />
            <Button Content="Recharger" Command="{Binding ReloadCommand}" Padding="12,4" Margin="8,0,0,0"
                    ToolTip="Relit le fichier pour prendre en compte les modifications faites dans Excel (F5)" />
            <TextBlock Text="Feuille :" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox ItemsSource="{Binding SheetNames}"
                      SelectedItem="{Binding SelectedSheet}"
                      MinWidth="160"
                      IsEnabled="{Binding FilePath, Converter={x:Static views:NotNullConverter.Instance}}" />
            <Button Content="Menu Données Excel" Click="ShowDataMenu_Click" Padding="12,4" Margin="16,0,0,0"
                    ToolTip="Ouvre le menu de la ligne active près de la souris" />

            <TextBlock Text="Rechercher :" VerticalAlignment="Center" Margin="16,0,6,0" />
            <Grid IsEnabled="{Binding FilePath, Converter={x:Static views:NotNullConverter.Instance}}">
                <TextBox x:Name="SearchBox" Width="220" VerticalContentAlignment="Center" Padding="4,2,22,2"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown"
                         ToolTip="Ctrl+F pour venir ici. Tous les mots doivent correspondre, accents et majuscules ignorés. Échap efface." />
                <!-- Croix d'effacement, sur le bord droit de la zone de saisie -->
                <Button Content="✕" Command="{Binding ClearSearchCommand}"
                        HorizontalAlignment="Right" Width="20" Margin="0,1,1,1" Padding="0"
                        Background="Transparent" BorderThickness="0" Foreground="#777777"
                        Cursor="Hand" Focusable="False" ToolTip="Effacer la recherche (Échap)"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </StackPanel>

        <!-- Proposition de reprendre le fichier de la dernière session -->
        <Border DockPanel.Dock="Top" Margin="8,0,8,8" Padding="10,6"
                Background="#E8F1FB" BorderBrush="#A9C8EC" BorderThickness="1" CornerRadius="3"
                Visibility="{Binding IsRecentFileOffered, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissRecentFileCommand}"
                        Width="24" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                        Foreground="#555555" Cursor="Hand" ToolTip="Masquer" />
                <Button DockPanel.Dock="Right" Content="Rouvrir" Command="{Binding ReopenRecentFileCommand}"
                        Padding="12,2" />
                <TextBlock Text="{Binding RecentFileText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RecentFilePath}" />
            </DockPanel>
        </Border>

        <!-- Barre d'état -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding ActiveRowText}" FontWeight="SemiBold" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Left" Margin="10,0" />
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding ShortcutText}" Foreground="#555555"
                           ToolTip="Ouvre le menu de la ligne active depuis n'importe quelle application" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding StatusText}" Foreground="#555555" />
            </StatusBarItem>
        </StatusBar>

        <!-- Colonnes générées dans MainWindow.xaml.cs à partir des en-têtes du fichier -->
        <DataGrid x:Name="DataTable"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#DDDDDD"
                  Background="White"
                  RowHeight="26"
                  MinColumnWidth="80"
                  PreviewKeyDown="DataTable_PreviewKeyDown"
                  Margin="8,0,8,8">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataTableRow_MouseDoubleClick" />
                    <Style.Triggers>
                        <!-- Ligne active : en gras sur fond jaune pâle -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static views:ReferenceEqualsConverter.Instance}">
                                    <Binding />
                                    <Binding Path="DataContext.ActiveRow" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Background" Value="#FFF3C4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>
