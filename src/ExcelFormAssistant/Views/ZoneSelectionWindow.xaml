<Window x:Class="ExcelFormAssistant.Views.ZoneSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélection de la zone du formulaire"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Background="#40000000">
    <!-- Fond légèrement assombri : entièrement transparent, la fenêtre laisserait passer les clics. -->
    <Canvas x:Name="Surface">
        <Border x:Name="Hint" Background="#E6202A24" CornerRadius="6" Padding="14,8" IsHitTestVisible="False">
            <TextBlock Foreground="White" FontSize="14">
                <Run FontWeight="SemiBold" Text="Tracez un rectangle autour des champs du formulaire" />
                <Run Text="  ·  Échap pour annuler" />
            </TextBlock>
        </Border>
        <Rectangle x:Name="Selection" Visibility="Collapsed" IsHitTestVisible="False"
                   Stroke="#5BC27D" StrokeThickness="2" Fill="#265BC27D" />
    </Canvas>
</Window>
